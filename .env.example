# z.ai API Configuration
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://api.z.ai
ZAI_MODEL=claude-3-sonnet-20240229

# Optional: Additional configuration
ZAI_MAX_TOKENS=4000
ZAI_TEMPERATURE=0.7
ZAI_DISABLE_CUSTOM_SEARCH=false

# Required for the Netlify HTTP endpoint; use a strong, random secret
MCP_AUTH_TOKEN=replace_with_a_strong_random_token
